{
  "name": "curo-emr",
  "version": "1.0.0",
  "description": "Curo EMR monorepo root",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @curo/shared",
    "test": "npm test --workspaces --if-present",
    "seed": "cd scripts && ts-node --project tsconfig.seed.json seed.ts",
    "typecheck:db": "tsc -p scripts/tsconfig.seed.json --noEmit",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build:backends": "bash scripts/build-backends-with-local-npm-registry.sh",
    "docker:rebuild": "bash scripts/docker-rebuild.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "typeorm": "^1.0.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  }
}
