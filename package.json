{
  "name": "curo-emr",
  "version": "1.0.0",
  "description": "Curo EMR monorepo root",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages -w services --if-present",
    "build:shared": "npm run build -w @curo/shared",
    "build:portals": "npm run build -w apps",
    "test": "npm test -w packages -w services --if-present",
    "test:e2e": "npm run test:e2e -w packages -w services --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:portals": "npm run lint -w apps -w packages/web",
    "db:migrate": "cd database && typeorm-ts-node-commonjs migration:run -d data-source.ts",
    "db:revert": "cd database && typeorm-ts-node-commonjs migration:revert -d data-source.ts",
    "db:generate": "cd database && typeorm-ts-node-commonjs migration:generate -d data-source.ts",
    "db:check": "cd database && typeorm-ts-node-commonjs migration:generate --check -d data-source.ts migrations/check",
    "seed": "cd database && ts-node seed.ts",
    "typecheck": "npm run typecheck -w packages -w services --if-present && npm run typecheck:db",
    "typecheck:db": "tsc -p database",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build:backends": "bash scripts/build-backends-with-local-npm-registry.sh",
    "docker:rebuild": "bash scripts/docker-rebuild.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
