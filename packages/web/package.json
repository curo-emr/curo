{
  "name": "@curo/web",
  "version": "1.0.0",
  "description": "Shared code for the Curo portals. Shipped as TypeScript source, which each portal's Next build compiles",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "exports": {
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./clinical": "./src/clinical/index.ts",
    "./fhir": "./src/fhir/index.ts",
    "./format": "./src/format/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./patients": "./src/patients/index.ts",
    "./print": "./src/print/index.ts",
    "./query": "./src/query/index.ts",
    "./styles.css": "./src/styles.css",
    "./ui/curo-calendar": "./src/ui/curo-calendar/index.ts",
    "./ui/utils": "./src/ui/utils.ts",
    "./ui/*": "./src/ui/*.tsx"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "test": "jest",
    "ui:add": "shadcn add",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.71.2",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.3.6"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node10",
            "isolatedModules": true
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
