{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    // Lets the shadcn CLI resolve the @curo/web/* aliases in components.json to folders.
    "paths": { "@curo/web/*": ["./src/*"] }
  },
  "include": ["src"]
}
