# Secrets for docker compose. Copy to .env (git-ignored) and edit:
#   cp .env.example .env
#
# These values are for local development only, and they match the fallbacks the
# services use when run from source. Replace every one for a shared or deployed
# environment: production images refuse to start without them.

# Postgres password, shared by the database container and every service.
# Postgres sets it only when the volume is created; to change it on an
# existing stack, run `docker compose down -v` (this deletes the data).
DB_PASS=curo_secret

# Sign and verify access and refresh tokens. Use long random values outside
# development, e.g. `openssl rand -base64 48`.
JWT_SECRET=curo_jwt_secret_dev_2024_change_in_prod
JWT_REFRESH_SECRET=curo_refresh_secret_dev_2024_change_in_prod

# MinIO root credentials, also used by the document service.
MINIO_ACCESS_KEY=curo
MINIO_SECRET_KEY=curo_secret_minio

# Optional: billing currency (default LKR).
# CURRENCY=LKR

# Optional: the clinic's time zone, an IANA name (default Asia/Colombo). Days in
# lists and reports follow it; the containers themselves stay on UTC.
# CLINIC_TIME_ZONE=Asia/Colombo
