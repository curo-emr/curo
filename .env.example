# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=curo
DB_PASSWORD=curo_secret
DB_NAME=curo_db
DB_URL=postgresql://curo:curo_secret@localhost:5432/curo_db

# JWT
JWT_SECRET=curo_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=curo_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PATIENT_SERVICE_PORT=3002
APPOINTMENT_SERVICE_PORT=3003
CLINICAL_SERVICE_PORT=3004
PHARMACY_SERVICE_PORT=3005
LAB_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
AUDIT_SERVICE_PORT=3008

# Billing
CURRENCY=LKR

# Frontend Origins (3015 = curo-admin super-admin portal, 3016 = curo-nurse)
FRONTEND_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:3012,http://localhost:3013,http://localhost:3014,http://localhost:3015,http://localhost:3016

# Redis (for sessions/caching)
REDIS_HOST=localhost
REDIS_PORT=6379
