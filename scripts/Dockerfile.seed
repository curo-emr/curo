# syntax=docker/dockerfile:1
# One-shot container that seeds the database, then exits.
FROM node:20-alpine
RUN apk add --no-cache python3 make g++
WORKDIR /app
# root-level deps only (ts-node, typeorm, pg, bcrypt, ...); the workspaces aren't needed
COPY package*.json ./
RUN npm ci --no-workspaces
# copy only the scripts folder
COPY scripts/ ./scripts/
CMD ["npm", "run", "seed"]
